<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hedworth.parakeet-ane</string>

	<!-- Speech-to-text for OpenWhispr: Parakeet Unified on the Neural Engine behind
	     an OpenAI-compatible /v1/audio/transcriptions endpoint on 127.0.0.1:11435.
	     OpenWhispr: Transcription > Self-hosted > OpenAI-compatible,
	     URL http://127.0.0.1:11435/v1 (any model name).

	     `make install` substitutes __HOME__ and installs this file. -->
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/parakeet-ane-server</string>
		<string>--model</string>
		<string>unified</string>
		<string>--port</string>
		<string>11435</string>
		<string>--ffmpeg</string>
		<string>/opt/homebrew/bin/ffmpeg</string>
		<string>--keep-warm</string>
		<string>30</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ProcessType</key>
	<string>Interactive</string>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/parakeet-ane-server.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/parakeet-ane-server.log</string>
</dict>
</plist>
